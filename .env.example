# Copy to .env and fill in. NEVER commit your real .env.
# Get a key at https://www.perplexity.ai/settings/api

# Required: your Perplexity API key (kept server-side, never returned in tool output).
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional tuning (defaults shown) ---

# Perplexity API base URL.
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Per-request HTTP timeout (seconds).
# PERPLEXITY_TIMEOUT=60

# Max bytes accepted from a single API response (DoS guard).
# PERPLEXITY_MAX_RESPONSE_BYTES=5242880

# Max retries for transient (5xx / network) failures, with jittered backoff.
# PERPLEXITY_MAX_RETRIES=3

# Token-bucket rate limit: sustained requests/minute and burst size.
# PERPLEXITY_RATE_PER_MINUTE=60
# PERPLEXITY_RATE_BURST=10

# Optional path for the JSON audit log. If unset, audit events go to stderr only.
# PERPLEXITY_AUDIT_LOG_PATH=/var/log/perplexity-agent/audit.log

# --- Optional hardened HTTP transport (off by default; stdio is the default) ---
# Only used when launched with `--transport http`.
# A bearer token clients must present (REQUIRED for HTTP mode). Keep it secret.
# PERPLEXITY_HTTP_AUTH_TOKEN=
# PERPLEXITY_HTTP_HOST=127.0.0.1
# PERPLEXITY_HTTP_PORT=8080
